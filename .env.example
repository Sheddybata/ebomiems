# Copy to .env.local. The app uses local SQLite until DATABASE_URL is set.

# Supabase → Project Settings → Database → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional. If unset, a secret is stored in data/secret for local use.
SESSION_SECRET=
